# ===========================================
# OneTimeSecret Environment Configuration
# ===========================================
# 
# HƯỚNG DẪN SỬ DỤNG:
# -------------------
# 1. Copy file này thành các file môi trường cụ thể:
#    - .env.development (cho development)
#    - .env.test (cho testing)
#    - .env.production (cho production)
#
# 2. Điều chỉnh giá trị phù hợp với từng môi trường
#
# THỨ TỰ ƯU TIÊN LOAD FILE:
# ---------------------------
# Khi ứng dụng chạy, hệ thống sẽ tìm và load file theo thứ tự:
#   1. .env.{NODE_ENV} (ví dụ: .env.test khi NODE_ENV=test)
#   2. .env (fallback nếu không tìm thấy file trên)
#   3. Giá trị mặc định trong code
#
# ⚠️  CHÚ Ý:
# - Chỉ CÓ MỘT file được load (file đầu tiên tìm thấy)
# - File .env nên dùng như fallback hoặc cho local development
# - KHÔNG commit file .env thật vào git (chỉ commit .env.example)
#
# ===========================================

# Node Environment (development | test | production)
NODE_ENV=development

# Server
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/secretdb

# Security & JWT
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Bcrypt (recommended: 7 for dev, 4 for test, 12 for production)
BCRYPT_SALT_ROUNDS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
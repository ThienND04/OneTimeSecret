# Node Environment (development | test | production)
NODE_ENV=development

# Server
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/secretdb

# Security & JWT
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Bcrypt (recommended: 7 for dev, 4 for test, 12 for production)
BCRYPT_SALT_ROUNDS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=noreply@abc.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@onetimesecret.com

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
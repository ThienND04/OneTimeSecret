{
    "name": "@onetimesecret/server",
    "version": "1.0.0",
    "description": "OneTimeSecret API Server",
    "private": true,
    "type": "commonjs",
    "main": "src/index.js",
    "scripts": {
        "start": "NODE_ENV=production node src/index.js",
        "dev": "NODE_ENV=development nodemon --inspect src/index.js",
        "test": "NODE_ENV=test jest --detectOpenHandles",
        "test:unit": "NODE_ENV=test jest tests/unit --detectOpenHandles",
        "test:integration": "NODE_ENV=test jest tests/integration --detectOpenHandles --silent"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "dotenv": "^17.0.1",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.1",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.16.1",
        "multer": "^2.0.1",
        "multer-storage-cloudinary": "^4.0.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^7.0.12",
        "swagger-cli": "^4.0.4",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0",
        "validator": "^13.15.26",
        "winston": "^3.18.3",
        "winston-daily-rotate-file": "^5.0.0",
        "yamljs": "^0.3.0",
        "zod": "^3.25.75"
    },
    "devDependencies": {
        "jest": "^30.0.4",
        "jest-extended": "^7.0.0",
        "morgan": "^1.10.1",
        "nodemon": "^3.1.10",
        "supertest": "^7.1.2"
    }
